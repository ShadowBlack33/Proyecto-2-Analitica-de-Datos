# ============================================================
# PENGWIN — archivos que nunca se suben a GitHub
# ============================================================

# ---------- Datos (pesan GB) ----------
/data/
*.mha
*.mhd
*.raw
*.nii
*.nii.gz
*.zip

# ---------- Pesos de modelos (se comparten por Drive / GitHub Releases) ----------
checkpoints/**
!checkpoints/.gitkeep
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx

# ---------- Salidas generadas al correr ----------
/resultados/
/runs/
wandb/
*.log
configs/notebook.yaml

# ---------- Entornos virtuales ----------
avenv/
.venv/
venv/
env/
ev/

# ---------- Python ----------
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.ipynb_checkpoints/

# ---------- Secretos y credenciales ----------
.env
*.token
kaggle.json
.streamlit/secrets.toml

# ---------- Editor y sistema ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*